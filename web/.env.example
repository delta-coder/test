# Local SQLite (default if unset):
# DATABASE_URL=sqlite:///./cinema.db

# Neon / Postgres for Vercel:
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:3000,https://YOUR-APP.vercel.app
HOLD_TTL_SECONDS=120
JWT_EXPIRE_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
ADMIN_EMAIL=admin@cinema.local